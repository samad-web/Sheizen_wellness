# ===== FRONTEND (Bundled into client - safe public keys ONLY) =====
# These VITE_ prefixed variables are exposed to the browser. NEVER put secrets here.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxx"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# ===== BACKEND ONLY (NEVER expose to frontend) =====
# These should be set in Supabase Edge Function secrets, NOT in this .env
# Supabase Dashboard → Edge Functions → Secrets:
#   - GEMINI_API_KEY (for AI assessment generation)
#   - VAPID_PRIVATE_KEY (for push notifications)
#   - VAPID_PUBLIC_KEY (for push notifications)
